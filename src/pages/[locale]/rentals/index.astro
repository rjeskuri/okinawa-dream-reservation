---
// /{locale}/rentals: the filter form and the grid. A complete, valid search, a date and time with a package or a type, lists
// what searchAvailability returns: with a type and no package, each class on its own default package, and none is chosen for
// the guest. Anything else lists the active models with a prompt, and type and cc wait for the search, since only class
// narrows without dates. Rendered from D1 on every request, so prices match the latest publish.
import { env } from "cloudflare:workers";
import DatePicker from "../../../components/DatePicker.astro";
import ModelCard from "../../../components/ModelCard.astro";
import { sheetName } from "../../../i18n/locales.ts";
import { common } from "../../../i18n/strings/common.ts";
import { rentals } from "../../../i18n/strings/rentals.ts";
import { t } from "../../../i18n/t.ts";
import Base from "../../../layouts/Base.astro";
import { CC_BANDS, searchAvailability } from "../../../lib/booking/availability.ts";
import { pickupSlots } from "../../../lib/booking/pickup-window.ts";
import { packageDays } from "../../../lib/calendar.ts";
import { photoUrl, readPhotoIndex } from "../../../lib/catalog/photos.ts";
import { readCatalog, type PublishedCatalog } from "../../../lib/db/catalog-store.ts";
import { isLocale } from "../../../lib/locale.ts";
import {
  cardPrice,
  carriedQuery,
  chosenPackage,
  findModels,
  hasEngineBand,
  listedModels,
  parseSearch,
} from "../../../lib/search.ts";
import { addDaysToDate, epochToJst, jstToday } from "../../../lib/time.ts";
import type { Package } from "../../../lib/types.ts";

const HOUR_MS = 3_600_000;

const { locale } = Astro.params;
// Astro's own check ignores case and sees any segment of the path, so it passes /JA/.
if (!isLocale(locale)) return new Response(null, { status: 404 });

const heading = t(locale, common, "nav.rentals");
const now = Date.now();

/** The page's view of a published catalog. searchAvailability throws before the first publish, so this needs one. */
async function list(catalog: PublishedCatalog) {
  const search = parseSearch(Astro.url.searchParams, catalog, catalog.config, catalog.closedDates, now);
  const found = await findModels(search, catalog.models, now, (query) => searchAvailability(env.DB, query));
  const pkg = chosenPackage(catalog.packages, search);
  const photos = await readPhotoIndex(env.DB);
  const carried = carriedQuery(search);

  const cards = listedModels(catalog.models, search, found).map((model) => ({
    model,
    href: `/${locale}/rentals/${model.id}${carried}`,
    priced: cardPrice(catalog.packages, catalog.prices, model.rateClassId, search, now),
    photo: model.photos.map((name) => photoUrl(name, photos)).find((url) => url !== null) ?? null,
    rateClass: catalog.rateClasses.find(({ id }) => id === model.rateClassId),
    depositJpy: catalog.vehicleTypes.find(({ id }) => id === model.typeId)?.depositJpy,
  }));
  return { search, complete: found !== null, pkg, cards };
}

/** A card's package label: empty when no package was chosen and the class has no day package to name. */
const packageName = (pkg: Package | undefined) => (pkg ? sheetName(pkg.texts, locale) : "");

const catalog = await readCatalog(env.DB);
const listing = catalog && (await list(catalog));
---

<Base locale={locale} title={`${heading} | ${t(locale, common, "site.name")}`}>
  <h1>{heading}</h1>
  {
    catalog === null || listing === null ? (
      <p>{t(locale, rentals, "rentals.unpublished")}</p>
    ) : (
      <>
        <form class="filters" action={`/${locale}/rentals`} method="get">
          <DatePicker
            locale={locale}
            min={epochToJst(now + catalog.config.minLeadHours * HOUR_MS).date}
            max={addDaysToDate(jstToday(now), catalog.config.maxDaysAhead)}
            closedDates={catalog.closedDates}
            value={listing.search.date}
            pkg={listing.pkg}
            shopClose={catalog.config.shopClose}
          />
          <label>
            {t(locale, rentals, "rentals.form.time")}
            <select name="time">
              <option value="">{t(locale, rentals, "rentals.form.chooseTime")}</option>
              {pickupSlots(catalog.config).map((slot) => (
                <option value={slot} selected={slot === listing.search.time}>
                  {slot}
                </option>
              ))}
            </select>
          </label>
          <label>
            {t(locale, rentals, "rentals.form.package")}
            <select name="package">
              <option value="">{t(locale, rentals, "rentals.form.any")}</option>
              {catalog.packages.map((pkg) => (
                <option
                  value={pkg.id}
                  data-days={packageDays(pkg)}
                  data-hours={pkg.hours ?? undefined}
                  selected={pkg.id === listing.pkg?.id}
                >
                  {sheetName(pkg.texts, locale)}
                </option>
              ))}
            </select>
          </label>
          <label>
            {t(locale, rentals, "rentals.form.type")}
            <select name="type">
              <option value="">{t(locale, rentals, "rentals.form.any")}</option>
              {catalog.vehicleTypes.map((type) => (
                <option value={type.id} selected={type.id === listing.search.typeId}>
                  {sheetName(type.texts, locale)}
                </option>
              ))}
            </select>
          </label>
          <label
            data-engine-filter
            hidden={listing.search.typeId !== undefined && !hasEngineBand(listing.search.typeId)}
          >
            {t(locale, rentals, "rentals.form.engine")}
            <select name="cc">
              <option value="">{t(locale, rentals, "rentals.form.any")}</option>
              {Object.keys(CC_BANDS).map((band) => (
                <option value={band} selected={band === listing.search.ccBand}>
                  {t(locale, rentals, `rentals.cc.${band}`)}
                </option>
              ))}
            </select>
          </label>
          {listing.search.rateClassId && <input type="hidden" name="class" value={listing.search.rateClassId} />}
          <button type="submit">{t(locale, rentals, "rentals.form.submit")}</button>
        </form>

        {listing.search.errors.length > 0 && (
          <p data-search-error>
            {[
              ...new Set(listing.search.errors.map(({ reason }) => t(locale, rentals, `rentals.error.${reason}`))),
              t(locale, rentals, "rentals.error.showingAll"),
            ].join(" ")}
          </p>
        )}
        {!listing.complete && <p data-search-prompt>{t(locale, rentals, "rentals.prompt")}</p>}
        {listing.cards.length === 0 && <p>{t(locale, rentals, "rentals.empty")}</p>}

        <div class="grid">
          {listing.cards.map(({ model, href, photo, rateClass, priced, depositJpy }) => (
            <ModelCard
              locale={locale}
              model={model}
              href={href}
              available={listing.complete}
              photo={photo}
              rateClassName={rateClass ? sheetName(rateClass.texts, locale) : ""}
              packageName={packageName(priced?.pkg ?? listing.pkg)}
              priceJpy={priced?.priceJpy}
              depositJpy={depositJpy}
            />
          ))}
        </div>
      </>
    )
  }
</Base>

<script>
  // Without JavaScript the server hides the engine select and ignores a band sent with a car or an e-bike, so this is only the
  // live view. The types are hasEngineBand's in src/lib/search.ts.
  const BANDLESS_TYPES = ["car", "ebike"];
  const form = document.querySelector("form.filters");
  const engine = form?.querySelector<HTMLElement>("[data-engine-filter]");
  const picker = form?.querySelector("date-picker");

  form?.addEventListener("change", (event) => {
    const select = event.target as HTMLSelectElement;
    if (select.name === "type" && engine) engine.hidden = BANDLESS_TYPES.includes(select.value);
    if (select.name === "package") {
      // The date field reads the package's pickup and return (#137): an hours package by its hours, any by neither.
      const { days, hours } = select.selectedOptions[0]?.dataset ?? {};
      if (hours === undefined) picker?.removeAttribute("package-hours");
      else picker?.setAttribute("package-hours", hours);
      if (days === undefined) picker?.removeAttribute("package-days");
      else picker?.setAttribute("package-days", days);
    }
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-lg);
  }
  .filters select {
    display: block;
  }
  /* The theme's `label { display: block }` outranks the browser's own [hidden] rule. */
  [data-engine-filter][hidden] {
    display: none;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
