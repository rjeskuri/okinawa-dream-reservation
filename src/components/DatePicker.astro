---
// The pickup date. The markup is a plain `<input type=date>`, which is all a guest without JavaScript gets; the script,
// src/scripts/date-picker.ts, swaps it for a date field that opens the month grid (#137) and writes the choice to the
// hidden `date` input instead. Closed dates exist only in the grid, because a date input cannot exclude them, so the server
// must still check what it receives.
//
// A page reports the chosen package by setting the `package-days` attribute of `<date-picker>` to packageDays of it, and
// `package-hours` to an hours package's hours (removing package-hours for a days package, and both for no package), and
// hears each pickup through the `change` event of the hidden input, which bubbles.
import { htmlLang } from "../i18n/locales.ts";
import { calendar } from "../i18n/strings/calendar.ts";
import { t } from "../i18n/t.ts";
import { packageDays } from "../lib/calendar.ts";
import type { Locale } from "../lib/locale.ts";
import type { PackageLength } from "../lib/types.ts";

interface Props {
  locale: Locale;
  /** The first selectable day, YYYY-MM-DD: the JST date of now + min_lead_hours. */
  min: string;
  /** The last selectable day, YYYY-MM-DD: today + max_days_ahead. */
  max: string;
  closedDates?: string[];
  /** The pickup date to start from, YYYY-MM-DD. */
  value?: string;
  /** The chosen package's length, when the page knows it. */
  pkg?: PackageLength | null;
  /** The shop's closing time, HH:mm as the sheet has it, which a days package is back by. */
  shopClose: string;
}

const { locale, min, max, closedDates = [], value, pkg, shopClose } = Astro.props;
const config = {
  locale,
  lang: htmlLang(locale),
  shopClose,
  closedDates,
  labels: {
    pickup: t(locale, calendar, "calendar.pickup"),
    return: t(locale, calendar, "calendar.return"),
    empty: t(locale, calendar, "calendar.field.empty"),
    past: t(locale, calendar, "calendar.reason.past"),
    too_far: t(locale, calendar, "calendar.reason.too_far"),
    closed: t(locale, calendar, "calendar.reason.closed"),
  },
};
---

<date-picker
  data-config={JSON.stringify(config)}
  package-days={pkg ? packageDays(pkg) : undefined}
  package-hours={pkg?.hours ?? undefined}
>
  <label data-fallback>
    {t(locale, calendar, "calendar.pickup")}
    <input type="date" name="date" min={min} max={max} value={value} />
  </label>
  <div class="date-picker-field" data-field-wrap hidden>
    <span class="date-picker-label" aria-hidden="true">{t(locale, calendar, "calendar.pickup")}</span>
    <button type="button" data-field aria-expanded="false"></button>
  </div>
  <div data-calendar hidden>
    <div class="date-picker-head">
      <button type="button" data-previous aria-label={t(locale, calendar, "calendar.previousMonth")}>&lsaquo;</button>
      <span data-month aria-live="polite"></span>
      <button type="button" data-next aria-label={t(locale, calendar, "calendar.nextMonth")}>&rsaquo;</button>
    </div>
    <table role="grid" aria-label={t(locale, calendar, "calendar.pickup")}>
      <thead><tr data-weekdays></tr></thead>
      <tbody data-weeks></tbody>
    </table>
  </div>
  <input type="hidden" name="date" disabled />
</date-picker>

<script src="../scripts/date-picker.ts"></script>

<style is:global>
  /* Global, because the script builds the cells and scoped styles only reach the markup above. */
  date-picker {
    display: inline-block;
    position: relative;
  }
  /* The theme's `label { display: block }` outranks the browser's own [hidden] rule. */
  date-picker [hidden] {
    display: none;
  }
  /* The field reads as its label and a control, like the selects beside it. */
  .date-picker-label {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-strong);
  }
  date-picker button[data-field] {
    min-height: var(--control-height);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    background: var(--color-background);
    color: var(--color-text);
    font-size: var(--font-size-base);
    font-weight: normal;
    text-align: start;
  }
  date-picker button[data-field]:hover {
    background: var(--color-background);
    color: var(--color-text);
  }
  .date-picker-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  /* The calendar opens over the page below the field. */
  date-picker [data-calendar] {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 10;
    margin-top: var(--space-1);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-base);
    background: var(--color-background);
    box-shadow: var(--shadow-raised);
  }
  .date-picker-head button {
    padding: var(--space-1) var(--space-3);
  }
  /* The theme's button fill and hover outrank the browser's disabled look. */
  date-picker button:disabled,
  date-picker button:disabled:hover {
    border-color: var(--color-border);
    background: var(--color-background);
    color: var(--color-text-muted);
    cursor: not-allowed;
  }
  date-picker table {
    border-collapse: collapse;
  }
  date-picker th,
  date-picker td {
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    text-align: center;
  }
  date-picker th {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-strong);
  }
  date-picker td {
    cursor: pointer;
  }
  date-picker td:focus-visible {
    /* The same ring as global.css, outside the cell: the token is only checked against the page background. */
    outline: 3px solid var(--color-focus-ring);
    outline-offset: 2px;
  }
  date-picker td.is-outside {
    color: var(--color-text-muted);
  }
  date-picker td[aria-disabled="true"] {
    color: var(--color-text-muted);
    cursor: not-allowed;
    text-decoration: line-through;
  }
  date-picker td.is-return {
    font-weight: bold;
    box-shadow: inset 0 0 0 2px var(--color-link);
  }
  date-picker td[aria-selected="true"] {
    background: var(--color-button-background);
    color: var(--color-button-text);
    font-weight: bold;
  }
</style>
