---
// One model on the listing: a single link around a photo with its labels on top, then the license, price and deposit. The
// labels sit on the header colours, whose contrast the tokens guarantee, because any photo can be behind them.
import { sheetName } from "../i18n/locales.ts";
import { rentals } from "../i18n/strings/rentals.ts";
import { t } from "../i18n/t.ts";
import type { Locale } from "../lib/locale.ts";
import type { Model } from "../lib/types.ts";

interface Props {
  locale: Locale;
  model: Model;
  href: string;
  /** Only for a model searchAvailability returned. */
  available: boolean;
  /** The first copied photo, or null to draw the placeholder. */
  photo: string | null;
  rateClassName: string;
  packageName: string;
  /** The class's price for the package, if it has one. */
  priceJpy?: number;
  depositJpy?: number;
}

const { locale, model, href, available, photo, rateClassName, packageName, priceJpy, depositJpy } = Astro.props;

const yen = (jpy: number) => t(locale, rentals, "rentals.amount").replace("{amount}", jpy.toLocaleString("en-US"));
---

<a class="card" href={href} data-model-id={model.id} data-available={available ? "" : undefined}>
  <div class="photo">
    {
      photo === null ? (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="1" />
          <circle cx="8.5" cy="10" r="1.5" />
          <path d="m3 17 5-4 4 3 4-5 5 5" />
        </svg>
      ) : (
        <img src={photo} alt="" loading="lazy" />
      )
    }
    <span class="label engine">{model.typeId === "car" ? rateClassName : `${model.engineCc}cc`}</span>
    <span class="label title">
      <small>{model.brand}</small>
      <strong>{sheetName(model.texts, locale)}</strong>
    </span>
  </div>
  <div class="details">
    <div>{t(locale, rentals, `rentals.license.${model.licenseClass}`)}</div>
    <div>
      {packageName && <>{packageName}: </>}
      {
        priceJpy === undefined ? (
          t(locale, rentals, "rentals.card.noPrice")
        ) : (
          <strong data-price>{yen(priceJpy)}</strong>
        )
      }
    </div>
    {
      depositJpy !== undefined && (
        <div>
          {t(locale, rentals, "rentals.card.deposit")}: <span data-deposit>{yen(depositJpy)}</span>
        </div>
      )
    }
  </div>
</a>

<style>
  /* The mock's photo-led card: the photo fills the top, the labels sit on the header's ink, the facts sit below. */
  .card {
    display: block;
    color: var(--color-text);
    text-decoration: none;
  }
  .card:hover {
    color: var(--color-text);
  }
  .photo {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }
  .photo img,
  .photo svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .photo svg {
    box-sizing: border-box;
    padding: var(--space-8);
  }
  .card:hover .photo img {
    transform: scale(1.035);
  }
  .label {
    position: absolute;
    left: var(--space-3);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--color-header-background);
    color: var(--color-header-text);
    line-height: 1.3;
  }
  .engine {
    top: var(--space-3);
    font-size: var(--font-size-lg);
    font-weight: 300;
  }
  .title {
    bottom: var(--space-3);
    margin-right: var(--space-3);
  }
  .title small {
    display: block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-strong);
    color: var(--color-header-link);
  }
  .title strong {
    font-weight: var(--font-weight-strong);
  }
  .details {
    padding: var(--space-2) var(--space-1) 0;
    font-size: var(--font-size-sm);
  }
  .details strong {
    font-size: var(--font-size-base);
  }
</style>
