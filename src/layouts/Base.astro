---
// The shell of every public page: html lang, title, hreflang alternates, header nav, language switcher and footer.
import { htmlLang, localePath } from "../i18n/locales.ts";
import { common } from "../i18n/strings/common.ts";
import { t } from "../i18n/t.ts";
import { LOCALES, type Locale } from "../lib/locale.ts";
import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  locale: Locale;
  title: string;
  /** False keeps the request's query out of the page, for a route that must not echo what a URL carries. */
  keepQuery?: boolean;
}

const { locale, title, keepQuery = true } = Astro.props;
// Pages render on demand, so the request's own origin gives the absolute hreflang URLs on any host.
const { origin, pathname, search } = Astro.url;
// Later tickets add these routes under src/pages/[locale]/.
const sections = ["rentals", "rates", "faq", "policies", "access"];
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {
      LOCALES.map((target) => (
        <link rel="alternate" hreflang={htmlLang(target)} href={origin + localePath(pathname, "", target)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${origin}/`} />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <header>
      <a class="brand" href={`/${locale}/`}>
        <img src="/logo.png" alt={t(locale, common, "site.name")} width="662" height="68" />
      </a>
      <nav class="sections" aria-label={t(locale, common, "nav.label")}>
        {sections.map((section) => <a href={`/${locale}/${section}/`}>{t(locale, common, `nav.${section}`)}</a>)}
      </nav>
      <nav class="languages" aria-label={t(locale, common, "language.label")}>
        {
          LOCALES.map((target) => (
            <a
              href={localePath(pathname, keepQuery ? search : "", target)}
              hreflang={htmlLang(target)}
              lang={htmlLang(target)}
              aria-current={target === locale ? "true" : undefined}
            >
              {t(locale, common, `language.${target}`)}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>{t(locale, common, "footer.rights")}</footer>
  </body>
</html>

<style is:global>
  :lang(en) {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }
  :lang(ja) {
    font-family: "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, "Noto Sans CJK JP", sans-serif;
  }
  :lang(zh-CN) {
    font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
  }
  :lang(ko) {
    font-family: "Apple SD Gothic Neo", "Malgun Gothic", "Noto Sans CJK KR", sans-serif;
  }
</style>

<style>
  /* The mock's dark header: the rainbow logo, light links on ink and a rainbow strip along the bottom. */
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    padding-bottom: calc(var(--space-4) + var(--rainbow-strip-height));
    background-color: var(--color-header-background);
    background-image: var(--gradient-rainbow);
    background-size: 100% var(--rainbow-strip-height);
    background-position: bottom;
    background-repeat: no-repeat;
    color: var(--color-header-text);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }
  .sections {
    margin-right: auto;
  }
  .brand {
    display: block;
    line-height: 0;
  }
  .brand img {
    height: var(--logo-height);
    width: auto;
  }
  header a {
    color: var(--color-header-link);
    text-decoration: none;
  }
  header nav a {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-sm);
    white-space: nowrap;
  }
  header a:hover {
    color: var(--color-header-link-hover);
  }
  header nav a:hover,
  .languages a[aria-current="true"] {
    background: var(--color-header-highlight);
    color: var(--color-header-link-hover);
  }
  header a:focus-visible {
    outline-color: var(--color-header-focus-ring);
  }
  .languages {
    gap: 0;
    border: 1px solid var(--color-header-highlight);
    border-radius: var(--radius-sm);
  }
  header .languages a {
    border-radius: 0;
  }
</style>
