{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Node runs src/lib/**/*.ts and the tests directly, so the code must be plain, erasable TypeScript
    // with explicit .ts extensions on relative imports.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "exclude": ["dist", ".wrangler"]
}
